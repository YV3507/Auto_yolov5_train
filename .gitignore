# ==================== YOLOv5子模块 ====================
# yolov5代码库由 VersionManager 自动缓存到 ~/.cache/yolov5/
# 如需要本地预置（project/yolov5/v5.0），取消注释对应条目
yolov5-5.0/
yolov5-6.0/
yolov5-7.0/
yolov5/

